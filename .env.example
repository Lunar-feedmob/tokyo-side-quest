# 东京支线 / Tokyo Side Quest — environment template.
# Copy to .env (local) or your secret store (production). Never commit real values.

# development | test | production. "test" enables the labelled fake AI provider only.
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# PostgreSQL 15+ with PostGIS (docker compose provides one on :5433 locally).
DATABASE_URL=postgres://tsq:tsq-local-password@127.0.0.1:5433/tsq
# Redis 7+ for BullMQ queues, rate limits and the worker heartbeat.
REDIS_URL=redis://127.0.0.1:6380
# ≥32 random characters: `openssl rand -hex 32`. Used to hash session/share tokens.
SESSION_SECRET=

# S3-compatible private bucket (local: SeaweedFS from docker compose).
STORAGE_ENDPOINT=http://127.0.0.1:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=tsq-local
STORAGE_ACCESS_KEY_ID=tsq-local-access
STORAGE_SECRET_ACCESS_KEY=tsq-local-secret-change-me
STORAGE_FORCE_PATH_STYLE=true

# MapLibre style JSON URL. Empty → map shows "暂不可用" and the list view is used.
# An owner can instead enter a MapTiler key in /admin → 设置; that takes precedence.
# Only put a token here if the provider allows public client use with origin restrictions.
MAP_STYLE_URL=
MAP_PUBLIC_TOKEN=

# Vision AI. Empty → photo verification is reported as unavailable (never faked).
# An owner can instead configure it in /admin → 设置 (key stored sealed with a key
# derived from SESSION_SECRET); saved admin settings take precedence over these.
#   AI_PROVIDER=anthropic          AI_VISION_MODEL=claude-opus-5-5
#   AI_PROVIDER=openai-compatible  AI_API_BASE_URL=https://.../v1  AI_VISION_MODEL=<vision model>
AI_PROVIDER=
AI_API_BASE_URL=
AI_API_KEY=
AI_VISION_MODEL=
# Bump when model/provider settings change so cached evaluations are not mixed.
AI_MODEL_CONFIG_VERSION=model-config-1
AI_TIMEOUT_MS=45000
# Site-wide model calls per day (Tokyo time). Each photo is usually 2 calls
# (verify, then rate). Owners can change it in /admin → 设置.
AI_DAILY_CALL_LIMIT=200

DEMO_ENABLED=true
# Labelled simulated location for testing only; refused when APP_ENV=production.
DEV_SIMULATED_LOCATION=false
LOCATION_RAW_RETENTION_HOURS=24
SHARE_TTL_DAYS=30
PHOTO_ATTEMPTS_PER_HOUR=10
PHOTO_ATTEMPTS_PER_IP_PER_HOUR=60
# true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Optional override for the poster font directory (default: packages/core/assets/fonts).
POSTER_FONT_DIR=
